:root{--font-sans:system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;--font-mono:ui-monospace,"SFMono-Regular",Menlo,Consolas,monospace;--bg:#f6f8fb;--bg-sunken:#eef2f7;--surface:#fff;--surface-2:#f8fafc;--border:#e6eaf0;--border-strong:#d2d8e2;--hairline:#eef1f6;--text:#0f172a;--text-2:#475569;--text-3:#64748b;--text-inv:#fff;--primary:#2563eb;--primary-strong:#1d4ed8;--primary-soft:#eff4fe;--primary-border:#c7d7f7;--primary-ink:#1d4ed8;--ok:#10b981;--ok-soft:#ecfdf5;--ok-border:#bbf0d6;--ok-ink:#047857;--warn:#d97706;--warn-soft:#fff7ed;--warn-border:#fde3be;--warn-ink:#b45309;--danger:#ef4444;--danger-soft:#fef2f2;--danger-border:#fecaca;--danger-ink:#b91c1c;--info:#3b82f6;--info-soft:#eff6ff;--info-border:#c7dafb;--info-ink:#1d4ed8;--streak:#f97316;--streak-soft:#fff7ed;--shadow-sm:0 1px 2px rgba(15,23,42,.04);--shadow-md:0 1px 2px rgba(15,23,42,.04),0 6px 16px -6px rgba(15,23,42,.08);--shadow-lg:0 1px 2px rgba(15,23,42,.05),0 20px 40px -12px rgba(15,23,42,.18);--r-xs:4px;--r-sm:6px;--r-md:10px;--r-lg:14px;--r-xl:20px;--r-pill:999px;--wp-bg:#1d2327;--wp-bg-2:#2c3338;--wp-text:#c3c4c7;--wp-text-dim:#8c8f94;--wp-active:#2271b1}*,:after,:before{box-sizing:border-box}#beepti-root{background:var(--bg);color:var(--text);font-family:var(--font-sans);font-feature-settings:"ss01","cv11";margin:0;min-height:calc(100vh - 32px);padding:0;-webkit-font-smoothing:antialiased;line-height:1.5;max-width:100%;overflow-x:hidden}.beepti-pw__plans{align-items:stretch;display:grid;gap:14px;grid-template-columns:.92fr .92fr 1.22fr}.beepti-pw__plan{border-radius:16px;display:flex;flex-direction:column;padding:16px 16px 18px}.beepti-pw__plan--pro{transform:scale(1.04);transform-origin:center}.beepti-pw__why{display:grid;gap:8px 18px;grid-template-columns:1fr 1fr}@media (max-width:640px){.beepti-pw__section{padding-left:20px!important;padding-right:20px!important}.beepti-pw__plans{display:flex;flex-direction:column;gap:16px}.beepti-pw__plan--pro{order:1;transform:none}.beepti-pw__plan--starter{order:2}.beepti-pw__why{grid-template-columns:1fr}.beepti-pw__plan--free{display:none}}#beepti-root button{color:inherit;font:inherit}#beepti-root a{color:var(--primary-ink);text-decoration:none}#beepti-root pre{overflow-wrap:anywhere}#beepti-root input::-moz-placeholder,#beepti-root textarea::-moz-placeholder{color:var(--text-3);font-weight:400;opacity:.7}#beepti-root input::placeholder,#beepti-root textarea::placeholder{color:var(--text-3);font-weight:400;opacity:.7}#beepti-root input:focus::-moz-placeholder,#beepti-root textarea:focus::-moz-placeholder{opacity:.45;-moz-transition:opacity .18s ease;transition:opacity .18s ease}#beepti-root input:focus::placeholder,#beepti-root textarea:focus::placeholder{opacity:.45;transition:opacity .18s ease}.bbt-input{background:var(--surface);border:1px solid var(--border);border-radius:var(--r-md);box-shadow:inset 0 1px 2px rgba(15,23,42,.025);box-sizing:border-box;color:var(--text);font-family:var(--font-sans);font-size:14px;outline:none;padding:11px 13px;transition:border-color .18s ease,box-shadow .18s ease,background .18s ease;width:100%}.bbt-input:focus{border-color:var(--primary);box-shadow:0 0 0 3px rgba(37,99,235,.18)}.bbt-input--sm{font-size:13px;padding:9px 12px}.bbt-input--area{line-height:1.5;resize:vertical}.bbt-field__label{color:var(--text-3);font-size:11px;font-weight:600;letter-spacing:.08em;text-transform:uppercase}.mono{font-family:var(--font-mono);font-feature-settings:"tnum","zero";overflow-wrap:anywhere}.tnum{font-variant-numeric:tabular-nums}.beepti-audit .beepti-card{transition:transform .16s ease,box-shadow .16s ease,border-color .15s ease}.beepti-audit .beepti-card:hover{box-shadow:var(--shadow-md);transform:translateY(-2px)}@media (prefers-reduced-motion:reduce){.beepti-audit .beepti-card:hover{transform:none}}.pulse-dot{animation:beepti-pulse 2.4s ease-out infinite;background:var(--ok);border-radius:999px;box-shadow:0 0 0 0 rgba(16,185,129,.45);display:inline-block;height:8px;position:relative;width:8px}.pulse-dot.warn{animation-name:beepti-pulse-warn;background:var(--warn);box-shadow:0 0 0 0 rgba(217,119,6,.45)}.pulse-dot.danger{animation-name:beepti-pulse-danger;background:var(--danger);box-shadow:0 0 0 0 rgba(239,68,68,.45)}@keyframes beepti-pulse{0%{box-shadow:0 0 0 0 rgba(16,185,129,.45)}70%{box-shadow:0 0 0 8px rgba(16,185,129,0)}to{box-shadow:0 0 0 0 rgba(16,185,129,0)}}@keyframes beepti-pulse-warn{0%{box-shadow:0 0 0 0 rgba(217,119,6,.45)}70%{box-shadow:0 0 0 8px rgba(217,119,6,0)}to{box-shadow:0 0 0 0 rgba(217,119,6,0)}}@keyframes beepti-pulse-danger{0%{box-shadow:0 0 0 0 rgba(239,68,68,.45)}70%{box-shadow:0 0 0 8px rgba(239,68,68,0)}to{box-shadow:0 0 0 0 rgba(239,68,68,0)}}@keyframes beepti-slide-up{0%{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}@keyframes beepti-fade-in{0%{opacity:0}to{opacity:1}}@keyframes beepti-scale-in{0%{opacity:0;transform:scale(.96)}to{opacity:1;transform:scale(1)}}@keyframes beepti-shimmer{0%{background-position:-200% 0}to{background-position:200% 0}}@keyframes beepti-gen-row{0%{opacity:0;transform:translateY(6px)}to{opacity:1;transform:translateY(0)}}@keyframes beepti-gen-check{0%{opacity:0;transform:scale(.4)}60%{opacity:1;transform:scale(1.18)}to{opacity:1;transform:scale(1)}}@keyframes beepti-phrase-in{0%{opacity:0;transform:translateY(2px)}to{opacity:1;transform:translateY(0)}}@keyframes beepti-success-pop{0%{opacity:0;transform:scale(.6)}60%{opacity:1;transform:scale(1.06)}to{opacity:1;transform:scale(1)}}@keyframes beepti-success-pulse{0%{box-shadow:0 0 0 0 rgba(16,185,129,.32)}60%{box-shadow:0 0 0 14px rgba(16,185,129,0)}to{box-shadow:0 0 0 0 rgba(16,185,129,0)}}@keyframes beepti-ambient{0%,to{box-shadow:0 0 0 0 rgba(16,185,129,0);opacity:.85;transform:scale(1)}50%{box-shadow:0 0 0 4px rgba(16,185,129,.16);opacity:1;transform:scale(1.15)}}@keyframes beepti-slide-right{0%{opacity:0;transform:translateX(16px)}to{opacity:1;transform:translateX(0)}}@keyframes beepti-fade-down{0%{opacity:0;transform:translateY(-2px)}to{opacity:1;transform:translateY(0)}}@keyframes beepti-refresh-sweep{0%{transform:translateX(-100%)}to{transform:translateX(350%)}}.beepti-lib-refresh-bar{animation:beepti-refresh-sweep 1.1s ease-in-out infinite}.fade-in{animation:beepti-fade-down .22s ease-out 1 both}.signedout-in{animation:beepti-slide-up .34s cubic-bezier(.2,.8,.2,1) 1 both}.gen-row-in{animation:beepti-gen-row .32s cubic-bezier(.2,.8,.2,1) 1 both}.gen-check{animation:beepti-gen-check .36s cubic-bezier(.2,.8,.2,1) 1 both}.phrase-in{animation:beepti-phrase-in .28s ease-out 1 both}.success-pulse{animation:beepti-success-pulse 1.6s ease-out 1;border-radius:var(--r-lg)}.onboarding-success{animation:beepti-success-pop .45s cubic-bezier(.2,.8,.2,1) 1 both}.ambient-pulse{animation:beepti-ambient 3.2s ease-in-out infinite}.shimmer-bar{animation:beepti-shimmer 1.4s linear infinite;background:linear-gradient(90deg,transparent,hsla(0,0%,100%,.6) 50%,transparent);background-size:200% 100%}#beepti-root ::-webkit-scrollbar{height:10px;width:10px}#beepti-root ::-webkit-scrollbar-thumb{background:#d2d8e2;border:2px solid var(--bg);border-radius:999px}#beepti-root ::-webkit-scrollbar-thumb:hover{background:#b7bfcb}#beepti-root :focus-visible{border-radius:4px;outline:2px solid var(--primary);outline-offset:2px}#beepti-root ::-moz-selection{background:var(--primary-soft);color:var(--primary-ink)}#beepti-root ::selection{background:var(--primary-soft);color:var(--primary-ink)}@media (prefers-reduced-motion:reduce){.ambient-pulse,.fade-in,.gen-check,.gen-row-in,.onboarding-success,.phrase-in,.pulse-dot,.shimmer-bar,.success-pulse{animation:none!important}}#wpcontent,#wpwrap{background:#f6f8fb}#wpbody,#wpbody-content,#wpcontent{padding-top:0!important}#wpcontent{padding-left:0!important;padding-right:0!important}#wpbody-content{padding-bottom:0!important}#wpbody-content,#wpbody-content .wrap{overflow-x:hidden}#wpbody-content>:not(#beepti-root){display:none!important}
